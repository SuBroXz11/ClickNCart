              "mode": "raw",
              "raw": "{\n    \"name\": \"My Awesome Shop\",\n    \"description\": \"We sell awesome products\",\n    \"address\": \"123 Main St, City\",\n    \"contact_number\": \"+1234567890\",\n    \"email\": \"shop@example.com\"\n}",
