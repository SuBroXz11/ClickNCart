      {
        "name": "User Protected Endpoints",
        "item": [
          {
            "name": "Rate Product (User)",
            "request": {
              "method": "POST",
              "header": [
                {
                  "key": "Authorization",
                  "value": "Bearer {{user_token}}",
                  "type": "text"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json",
                  "type": "text"
                }
              ],
              "body": {
                "mode": "raw",
                "raw": "{\n  \"rating\": 5\n}"
              },
              "url": {
                "raw": "{{base_url}}/api/products/PROD123456/rate",
                "host": ["{{base_url}}"],
                "path": ["api", "products", "PROD123456", "rate"]
              },
              "description": "Rate a product (user only)"
            },
            "response": []
          }
        ]
      }
    ],
